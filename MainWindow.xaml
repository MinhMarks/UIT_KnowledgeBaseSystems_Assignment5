<Window x:Class="SortingVisualizer.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Sorting Algorithm Visualizer" 
        Height="750" Width="1200"
        MinHeight="650" MinWidth="1000"
        WindowStartupLocation="CenterScreen"
        Background="#1e1e2e"
        Icon="app.ico">
    
    <Window.Resources>
        <!-- Button Style -->
        <Style x:Key="ModernButton" TargetType="Button">
            <Setter Property="Background" Value="#89b4fa"/>
            <Setter Property="Foreground" Value="#1e1e2e"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Padding" Value="15,8"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" 
                                CornerRadius="6" 
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#b4befe"/>
                </Trigger>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="Background" Value="#45475a"/>
                    <Setter Property="Foreground" Value="#6c7086"/>
                </Trigger>
            </Style.Triggers>
        </Style>
        
        <!-- Green Button -->
        <Style x:Key="GreenButton" TargetType="Button" BasedOn="{StaticResource ModernButton}">
            <Setter Property="Background" Value="#a6e3a1"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#94e2d5"/>
                </Trigger>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="Background" Value="#45475a"/>
                    <Setter Property="Foreground" Value="#6c7086"/>
                </Trigger>
            </Style.Triggers>
        </Style>
        
        <!-- Orange Button -->
        <Style x:Key="OrangeButton" TargetType="Button" BasedOn="{StaticResource ModernButton}">
            <Setter Property="Background" Value="#fab387"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#f9e2af"/>
                </Trigger>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="Background" Value="#45475a"/>
                    <Setter Property="Foreground" Value="#6c7086"/>
                </Trigger>
            </Style.Triggers>
        </Style>
        
        <!-- Red Button -->
        <Style x:Key="RedButton" TargetType="Button" BasedOn="{StaticResource ModernButton}">
            <Setter Property="Background" Value="#f38ba8"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#eba0ac"/>
                </Trigger>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="Background" Value="#45475a"/>
                    <Setter Property="Foreground" Value="#6c7086"/>
                </Trigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>
    
    <Grid Margin="15">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        
        <!-- Title -->
        <StackPanel Grid.Row="0" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,0,0,15">
            <Button x:Name="btnBack" Content="← Trang chủ" 
                    Style="{StaticResource ModernButton}" 
                    Click="BtnBack_Click"
                    VerticalAlignment="Center"
                    Margin="0,0,20,0"/>
            <TextBlock Text="🔢 Sorting Algorithm Visualizer" 
                       FontSize="26" 
                       FontWeight="Bold" 
                       Foreground="#cdd6f4"
                       VerticalAlignment="Center"/>
        </StackPanel>
        
        <!-- Input Section -->
        <Border Grid.Row="1" Background="#313244" CornerRadius="10" Padding="12" Margin="0,0,0,10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                
                <StackPanel Grid.Column="0" Orientation="Horizontal">
                    <TextBlock Text="Nhập dãy số:" Foreground="#cdd6f4" VerticalAlignment="Center" Margin="0,0,10,0"/>
                    <TextBox x:Name="txtInput" 
                             Width="280" 
                             Height="32"
                             FontSize="13"
                             Padding="8,5"
                             Background="#45475a"
                             Foreground="#cdd6f4"
                             BorderBrush="#585b70"
                             BorderThickness="1"
                             VerticalContentAlignment="Center"
                             Text="64, 34, 25, 12, 22, 11, 90, 45"/>
                </StackPanel>
                
                <Button Grid.Column="1" 
                        x:Name="btnApplyManual"
                        Content="Áp dụng" 
                        Style="{StaticResource ModernButton}"
                        Margin="10,0,0,0"
                        Click="BtnApplyManual_Click"/>
                
                <StackPanel Grid.Column="2" Orientation="Horizontal" Margin="15,0,0,0">
                    <TextBlock Text="Số lượng:" Foreground="#cdd6f4" VerticalAlignment="Center" Margin="0,0,8,0"/>
                    <TextBox x:Name="txtCount" 
                             Width="50" 
                             Height="32"
                             FontSize="13"
                             Padding="8,5"
                             Background="#45475a"
                             Foreground="#cdd6f4"
                             BorderBrush="#585b70"
                             BorderThickness="1"
                             VerticalContentAlignment="Center"
                             HorizontalContentAlignment="Center"
                             Text="12"/>
                </StackPanel>
                
                <Button Grid.Column="3" 
                        x:Name="btnRandom"
                        Content="🎲 Ngẫu nhiên" 
                        Style="{StaticResource GreenButton}"
                        Margin="10,0,0,0"
                        Click="BtnRandom_Click"/>
                
                <Button Grid.Column="4" 
                        x:Name="btnReset"
                        Content="🔄 Reset" 
                        Style="{StaticResource RedButton}"
                        Margin="10,0,0,0"
                        Click="BtnReset_Click"/>
            </Grid>
        </Border>
        
        <!-- Control Section -->
        <Border Grid.Row="2" Background="#313244" CornerRadius="10" Padding="12" Margin="0,0,0,10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                
                <StackPanel Grid.Column="0" Orientation="Horizontal">
                    <TextBlock Text="Thuật toán:" Foreground="#cdd6f4" VerticalAlignment="Center" Margin="0,0,8,0"/>
                    <ComboBox x:Name="cboAlgorithm" 
                              Width="140" 
                              Height="32"
                              FontSize="13"
                              SelectedIndex="0"
                              Background="#45475a"
                              Foreground="#1e1e2e"
                              SelectionChanged="CboAlgorithm_SelectionChanged">
                        <ComboBoxItem Content="Selection Sort"/>
                        <ComboBoxItem Content="Quick Sort"/>
                    </ComboBox>
                </StackPanel>
                
                <Button Grid.Column="1" 
                        x:Name="btnStart"
                        Content="▶ Start" 
                        Style="{StaticResource GreenButton}"
                        Margin="15,0,0,0"
                        Click="BtnStart_Click"/>
                
                <Button Grid.Column="2" 
                        x:Name="btnPause"
                        Content="⏸ Pause" 
                        Style="{StaticResource OrangeButton}"
                        Margin="8,0,0,0"
                        IsEnabled="False"
                        Click="BtnPause_Click"/>
                
                <Button Grid.Column="3" 
                        x:Name="btnNextStep"
                        Content="⏭ Next" 
                        Style="{StaticResource ModernButton}"
                        Margin="8,0,0,0"
                        Click="BtnNextStep_Click"/>
                
                <StackPanel Grid.Column="5" Orientation="Horizontal">
                    <TextBlock Text="Tốc độ:" Foreground="#cdd6f4" VerticalAlignment="Center" Margin="0,0,8,0"/>
                    <Slider x:Name="sliderSpeed" 
                            Width="120" 
                            Minimum="50" 
                            Maximum="1000" 
                            Value="300"
                            VerticalAlignment="Center"
                            IsDirectionReversed="True"/>
                    <TextBlock x:Name="txtSpeed" Text="300ms" Foreground="#a6adc8" VerticalAlignment="Center" Margin="8,0,0,0" Width="45"/>
                </StackPanel>
            </Grid>
        </Border>
        
        <!-- Main Content: Pseudocode + Visualization -->
        <Grid Grid.Row="3">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="280"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            
            <!-- Pseudocode Panel -->
            <Border Grid.Column="0" Background="#313244" CornerRadius="10" Padding="10" Margin="0,0,10,0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    
                    <TextBlock Grid.Row="0" 
                               Text="📝 Mã giả (Pseudocode)" 
                               FontSize="14" 
                               FontWeight="Bold" 
                               Foreground="#89b4fa"
                               Margin="0,0,0,10"/>
                    
                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                        <StackPanel x:Name="pseudocodePanel">
                            <!-- Pseudocode lines will be added dynamically -->
                        </StackPanel>
                    </ScrollViewer>
                </Grid>
            </Border>
            
            <!-- Visualization Area -->
            <Border Grid.Column="1" Background="#313244" CornerRadius="10" Padding="10">
                <Canvas x:Name="canvasVisualization" Background="#313244"/>
            </Border>
        </Grid>
        
        <!-- Statistics Section -->
        <Border Grid.Row="4" Background="#313244" CornerRadius="10" Padding="12" Margin="0,10,0,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                
                <StackPanel Grid.Column="0" Orientation="Horizontal" HorizontalAlignment="Center">
                    <TextBlock Text="Thuật toán: " Foreground="#a6adc8" FontSize="13"/>
                    <TextBlock x:Name="txtAlgorithmName" Text="Selection Sort" Foreground="#89b4fa" FontSize="13" FontWeight="Bold"/>
                </StackPanel>
                
                <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Center">
                    <TextBlock Text="So sánh: " Foreground="#a6adc8" FontSize="13"/>
                    <TextBlock x:Name="txtComparisons" Text="0" Foreground="#f9e2af" FontSize="13" FontWeight="Bold"/>
                </StackPanel>
                
                <StackPanel Grid.Column="2" Orientation="Horizontal" HorizontalAlignment="Center">
                    <TextBlock Text="Hoán đổi: " Foreground="#a6adc8" FontSize="13"/>
                    <TextBlock x:Name="txtSwaps" Text="0" Foreground="#f38ba8" FontSize="13" FontWeight="Bold"/>
                </StackPanel>
                
                <StackPanel Grid.Column="3" Orientation="Horizontal" HorizontalAlignment="Center">
                    <TextBlock Text="Trạng thái: " Foreground="#a6adc8" FontSize="13"/>
                    <TextBlock x:Name="txtStatus" Text="Sẵn sàng" Foreground="#a6e3a1" FontSize="13" FontWeight="Bold"/>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
